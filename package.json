{
  "name": "@ata-project/valibot",
  "version": "0.2.0",
  "description": "Run valibot schemas on the ata engine: same answers, verdicts in nanoseconds",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "build.js",
    "build.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ata-core/ata-valibot.git"
  },
  "scripts": {
    "test": "node test.js && node --disallow-code-generation-from-strings test.js && npm run test:types",
    "bench": "node bench.mjs",
    "test:types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.3.0",
    "ata-validator": "^1.13.2"
  },
  "peerDependencies": {
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.6.0",
    "valibot": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.js"
    },
    "./package.json": "./package.json"
  }
}
